<section anchor="_icalendar_and_vcard_property_parameter_registration_phonetic"><name>iCalendar and vCard Property Parameter Registration: PHONETIC</name>

<dl anchor="_ac90c02e-8b23-4afd-b17e-2f3e6cfc6b63"><dt>Namespace</dt><dd></dd><dt>Parameter name</dt><dd>
<t anchor="_832331df-e2e7-4c0a-94d8-16f9f85cee2c">PHONETIC</t>
</dd><dt>Purpose</dt><dd>
<t anchor="_52fac8fa-20ec-4df7-84c0-77cbd65fc6b9">Given in <xref target="pp-phonetic"></xref>.</t>
</dd><dt>Description</dt><dd>
<t anchor="_e70624d3-d871-436f-8bcc-e2e6f3496291">Given in <xref target="pp-phonetic"></xref>.</t>
</dd><dt>Format definition</dt><dd>
<t anchor="_daf3c93d-f78b-4bf2-9736-21dbdbc2d268">Given in <xref target="pp-phonetic"></xref>.</t>
</dd><dt>Examples</dt><dd>
<t anchor="_2dce9eac-3d7a-4cab-a0f0-e4188c1c625f">Given in <xref target="pp-phonetic"></xref>.</t>
</dd></dl>
